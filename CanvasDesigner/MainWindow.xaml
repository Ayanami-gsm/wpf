<Window x:Class="CanvasDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CanvasDesigner.ViewModels"
        xmlns:conv="clr-namespace:CanvasDesigner.Converters"
        xmlns:ctrl="clr-namespace:CanvasDesigner.Controls"
        Title="CanvasDesigner - 通用画面编辑器"
        Width="1220" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF263238"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvB2V" />
        <conv:StringToBrushConverter x:Key="StrBrush" />

        <ctrl:EditorTemplateSelector x:Key="EditorSelector" />

        <!-- 属性编辑器模板：名称对应 PropertyRowViewModel.Kind -->
        <DataTemplate x:Key="Editor_Text">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="Editor_MultiText">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="54" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" />
        </DataTemplate>

        <DataTemplate x:Key="Editor_Number">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="Editor_Bool">
            <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="Editor_Color">
            <ComboBox IsEditable="True"
                      ItemsSource="{x:Static conv:Palette.Colors}"
                      Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="12" Margin="0,0,6,0"
                                       Fill="{Binding Converter={StaticResource StrBrush}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <DataTemplate x:Key="Editor_Options">
            <ComboBox ItemsSource="{Binding Options}"
                      SelectedItem="{Binding OptionValue}" />
        </DataTemplate>

        <DataTemplate x:Key="Editor_Font">
            <ComboBox IsEditable="True"
                      ItemsSource="{Binding DataContext.FontList, RelativeSource={RelativeSource AncestorType=Window}}"
                      Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" />
        </DataTemplate>

        <DataTemplate x:Key="Editor_File">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="…" Padding="0"
                        Command="{Binding BrowseCommand}" />
            </Grid>
        </DataTemplate>

        <!-- 工具箱条目 -->
        <DataTemplate x:Key="ToolboxItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IconChar}" FontSize="16" Width="24"
                           VerticalAlignment="Center" TextAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                    <TextBlock Text="{Binding ComponentType.Name}" FontSize="10"
                               Foreground="#FF8CA9B8" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 属性分组显示 -->
        <DataTemplate x:Key="PropGroupTemplate">
            <StackPanel Margin="0,2,0,6">
                <TextBlock Text="{Binding Category}" FontWeight="Bold"
                           Foreground="#FFE0F2F1" Margin="2,4,0,2" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           VerticalAlignment="Center"
                                           Foreground="#FFCFD8DC"
                                           TextTrimming="CharacterEllipsis" />
                                <ContentControl Grid.Column="1" Content="{Binding}"
                                                ContentTemplateSelector="{StaticResource EditorSelector}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部：菜单 + 快捷工具栏 -->
        <Border DockPanel.Dock="Top" Background="#FF1C262B" Padding="4">
            <StackPanel>
                <Menu Background="Transparent" Foreground="White">
                    <MenuItem Header="文件(_F)">
                        <MenuItem Header="新建" Click="New_Click" InputGestureText="Ctrl+N" />
                        <MenuItem Header="打开…" Click="Open_Click" InputGestureText="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="保存" Click="Save_Click" InputGestureText="Ctrl+S" />
                        <MenuItem Header="另存为…" Click="SaveAs_Click" />
                        <Separator />
                        <MenuItem Header="退出" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="编辑(_E)">
                        <MenuItem Header="复制选中" Click="Copy_Click" InputGestureText="Ctrl+D" />
                        <MenuItem Header="删除选中" Click="Delete_Click" InputGestureText="Del" />
                        <Separator />
                        <MenuItem Header="上移一层" Click="LayerUp_Click" />
                        <MenuItem Header="下移一层" Click="LayerDown_Click" />
                        <MenuItem Header="置于顶层" Click="Top_Click" />
                        <MenuItem Header="置于底层" Click="Bottom_Click" />
                    </MenuItem>
                    <MenuItem Header="帮助(_H)">
                        <MenuItem Header="操作说明" Click="Help_Click" />
                    </MenuItem>
                </Menu>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="新建" Click="New_Click" Margin="0,0,4,0" Padding="10,2" />
                    <Button Content="打开" Click="Open_Click" Margin="0,0,4,0" Padding="10,2" />
                    <Button Content="保存" Click="Save_Click" Margin="0,0,10,0" Padding="10,2" />
                    <Button Content="复制" Click="Copy_Click" Margin="0,0,4,0" Padding="10,2" />
                    <Button Content="删除" Click="Delete_Click" Margin="0,0,10,0" Padding="10,2" />
                    <TextBlock Text="画布:" VerticalAlignment="Center" Foreground="#FFB0BEC5" />
                    <TextBox x:Name="TxtCanvasW" Width="60" VerticalContentAlignment="Center"
                             LostFocus="TxtCanvasW_LostFocus" />
                    <TextBlock Text="×" VerticalAlignment="Center" Foreground="#FFB0BEC5" Margin="2,0" />
                    <TextBox x:Name="TxtCanvasH" Width="60" VerticalContentAlignment="Center"
                             LostFocus="TxtCanvasH_LostFocus" />
                    <TextBlock Text="  网格:" VerticalAlignment="Center" Foreground="#FFB0BEC5" />
                    <TextBox x:Name="TxtGrid" Width="40" VerticalContentAlignment="Center"
                             LostFocus="TxtGrid_LostFocus" />
                    <CheckBox x:Name="ChkGrid" Content="网格" IsChecked="True"
                              Checked="GridToggled" Unchecked="GridToggled"
                              Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkSnap" Content="吸附"
                              IsChecked="{Binding SnapEnabled, Mode=TwoWay}"
                              Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="  背景色:" VerticalAlignment="Center" Foreground="#FFB0BEC5" />
                    <TextBox x:Name="TxtBackground" Width="110"
                             VerticalContentAlignment="Center"
                             LostFocus="TxtBackground_LostFocus" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部状态 -->
        <Border DockPanel.Dock="Bottom" Background="#FF1C262B" Padding="6,2">
            <TextBlock x:Name="TxtStatus" Text="{Binding Status}" Foreground="#FFCFD8DC" />
        </Border>

        <!-- 主体 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 左：工具箱 -->
            <Border Grid.Column="0" Background="#FF1C262B" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="组件库（单击选型→点画布放置，双击直接添加）"
                               Foreground="#FFB0BEC5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ListBox x:Name="ToolboxList"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White"
                             ItemTemplate="{StaticResource ToolboxItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Toolbox_SelectionChanged"
                             MouseDoubleClick="Toolbox_MouseDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold" Foreground="#FF4FC3F7"
                                                   Margin="0,8,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Background="#FF141A1E" />
            <Border Grid.Column="3" Background="#FF141A1E" />

            <!-- 中：画布 -->
            <Grid Grid.Column="2" Background="#FF141A1E">
                <ScrollViewer x:Name="CanvasScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ctrl:DesignerSurface x:Name="Surface"
                                          MouseLeftButtonDown="Surface_MouseLeftButtonDown" />
                </ScrollViewer>
            </Grid>

            <!-- 右：属性 -->
            <Grid Grid.Column="4" Background="#FF1C262B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF26343C" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="选中组件" Foreground="#FF90A4AE" FontSize="12" />
                        <TextBlock x:Name="TxtSelectedHeader" Foreground="White"
                                   FontSize="15" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 无选中提示 -->
                <TextBlock Grid.Row="1" Text="（未选中：\n单击图元进入编辑；\n在左侧点选组件类型后点画布即可放置）"
                           Foreground="#FF78909C" FontSize="12" Margin="8,8"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasSelection, Converter={StaticResource InvB2V}}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PropertyGroups}"
                                  ItemTemplate="{StaticResource PropGroupTemplate}"
                                  Margin="8,0,8,8" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
