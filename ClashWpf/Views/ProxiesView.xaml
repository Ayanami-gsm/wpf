<UserControl x:Class="ClashWpf.Views.ProxiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="刷新列表" Padding="12,6" Margin="0,0,8,0" cal:Message.Attach="[Click] = [Reload]"/>
            <Button Content="测延迟（全部组）" Padding="12,6" Margin="0,0,8,0" cal:Message.Attach="[Click] = [TestAllGroups]"/>
            <Button Content="测延迟（选中组）" Padding="12,6" cal:Message.Attach="[Click] = [TestSelectedGroupDelay]"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#6B7280"/>
        </StackPanel>

        <!-- 代理组 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Background="White" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="代理组" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="当前节点" Binding="{Binding Now}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 选中组 -->
        <Border Grid.Row="2" Background="#F9FAFB" Padding="8,6" CornerRadius="4">
            <TextBlock FontSize="12" Foreground="#374151">
                <Run Text="成员列表：选中组后点「切换」更换该组当前节点；测延迟仅作用于组当前节点。"/>
            </TextBlock>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedGroup.Nodes}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Background="White">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="节点" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="（当前）" Foreground="#059669" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="延迟" Binding="{Binding DelayText}" Width="110"/>
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="切换" Padding="8,2" FontSize="11"
                                    cal:Message.Attach="[Click] = [SelectNode($dataContext)]"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
