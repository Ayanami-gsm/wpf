<UserControl x:Class="ClashWpf.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="打开日志文件" Padding="12,6" Margin="0,0,8,0"
                        cal:Message.Attach="[Click] = [OpenLogFile]"/>
                <Button Content="清空" Padding="12,6"
                        cal:Message.Attach="[Click] = [Clear]"/>
            </StackPanel>
            <TextBlock Text="{Binding CountText, StringFormat='共 {0}'}" VerticalAlignment="Center"
                       Foreground="#6B7280" FontSize="12"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="8">
            <ListBox x:Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                     BorderThickness="0" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#D4D4D4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="#F87171"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
