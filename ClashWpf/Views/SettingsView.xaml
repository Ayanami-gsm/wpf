<UserControl x:Class="ClashWpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="引擎内核" FontSize="15" FontWeight="SemiBold" Foreground="#374151"/>
            <Grid Margin="0,6,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding CorePath, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="12" Padding="6" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="浏览…" Padding="14,6" Margin="8,0,0,0"
                        cal:Message.Attach="[Click] = [BrowseCore]"/>
            </Grid>

            <TextBlock Text="订阅地址（Clash/mihomo 格式 YAML）" FontSize="15" FontWeight="SemiBold" Foreground="#374151"/>
            <TextBox Text="{Binding SubscriptionUrl, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="12" Padding="6" Margin="0,6,0,4" TextWrapping="Wrap" AcceptsReturn="False"/>
            <TextBlock Text="提示：部分机场需要特定 User-Agent；本程序已内置常见兼容 UA。生成结果写入 %APPDATA%\ClashWpf\run\config.yaml"
                       Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="混合端口" Foreground="#6B7280" FontSize="12"/>
                    <TextBox Text="{Binding MixedPort, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="控制器端口" Foreground="#6B7280" FontSize="12"/>
                    <TextBox Text="{Binding ControllerPort, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="运行模式" Foreground="#6B7280" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                              Padding="4" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="控制器 Secret（可选，与 config 一致）" Foreground="#6B7280" FontSize="12"/>
                    <PasswordBox x:Name="SecretBox" Padding="6" FontSize="13" Margin="0,4,0,0"
                                 PasswordChanged="SecretBox_PasswordChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="测延迟 URL" Foreground="#6B7280" FontSize="12"/>
                    <TextBox Text="{Binding LatencyTestUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <CheckBox Content="允许局域网访问（allow-lan）" IsChecked="{Binding AllowLan}"
                      Margin="0,16,0,0" FontSize="13"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="保存设置" Padding="18,8" Margin="0,0,10,0" FontWeight="SemiBold"
                        cal:Message.Attach="[Click] = [Save]"/>
                <Button Content="测试订阅并生成配置" Padding="18,8" Margin="0,0,10,0"
                        cal:Message.Attach="[Click] = [TestSubscription]"/>
                <Button Content="打开配置目录" Padding="14,8"
                        cal:Message.Attach="[Click] = [OpenConfigDir]"/>
            </StackPanel>

            <TextBlock Text="{Binding Message}" Foreground="#2563EB" FontSize="12" Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <Border Background="#FEF3C7" CornerRadius="6" Padding="14" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="怎么获取 mihomo 内核？" FontWeight="SemiBold" Foreground="#92400E"/>
                    <TextBlock Foreground="#78350F" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                        <Run Text="1. 去 GitHub MetaCubeX/mihomo releases 下载 windows-amd64 版；或从已安装的 Clash 客户端目录里复制 mihomo.exe。"/>
                        <LineBreak/>
                        <Run Text="2. 放到本程序目录的 core\mihomo.exe（推荐），或在上面「内核路径」里手动指定。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
